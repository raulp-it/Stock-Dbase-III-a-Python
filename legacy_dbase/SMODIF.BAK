DO WHILE .T.
    DO ENCABEZ
    STORE 0 TO vcod_merc
    STORE SPACE(1) TO SINO
    SELECT 1
    @7,33 SAY "MENU MODIFICAR"
    @24,1 SAY "CODIGO DE MERCADERIA = 0 PARA TERMINAR."
    @10,2 SAY "Codigo de mercaderia: "GET vcod_merc PICTURE '999999'
    READ
    IF VCOD_MERC = 0
        EXIT
    ENDIF
    SEEK VCOD_MERC
    IF EOF()
        @24,1
        @23,23 SAY "CODIGO INEXISTENTE..."
        WAIT 'Pulse una tecla para continuar'
        @23,0
        LOOP
    ELSE
** ------------------------------------------------------------
**  REEMPLAZAR EL CONTENIDO DE LAS VARIABLES CON EL CONTENIDO DE ç
LOS CAMPOS
** ------------------------------------------------------------
        STORE DESC TO VDESC
        SELECT 2
        STORE S_ACTUAL TO VS_ACT
        STORE S_MINIMO TO VS_MIN
        SELECT 1
        STORE P_COSTO TO VP_COSTO
        STORE GANANCIA TO VGAN
        STORE IVA TO VIVA
        STORE P_LISTA TO VP_LISTA
** -------------------
** CONFIRMAR LOS DATOS
** -------------------
        @12,2 SAY "DESCRIPCION: "GET VDESC PICT '@!'
        @14,2 SAY "STOCK ACTUAL: "GET VS_ACT PICTURE '999'
        @14,40 SAY "STOCK MINIMO: "GET VS_MIN PICTURE '999'
        @16,2 SAY "PRECIO DE COSTO: "GET VP_COSTO PICTURE ç
'99999.99'
        @16,40 SAY "% GANACIA: "GET VGAN PICTURE '999.99'
        READ
        VP_NETO = VP_COSTO * (1 + VGAN /100)
        @16,60 SAY "NETO: "+LTRIM(STR(VP_NETO,8,2))
        @18,2 SAY "% IVA: "GET VIVA PICT '999.99'
        READ
        VP_LISTA = VP_NETO * (1 + VIVA / 100)        
        @18,50 SAY "PRECIO DE LISTA: "+LTRIM(STR(VP_LISTA,8,2))
        @23,54 SAY "DATOS CORRECTOS (S/N)?"GET sino PICTURE "!"
        READ
        @23,0
        @10,2 CLEAR TO 21,77
        IF SINO = 'S'
            SELECT 1
            REPLACE COD_MERC WITH VCOD_MERC
            REPLACE DESC WITH VDESC
            REPLACE P_COSTO WITH VP_COSTO
            REPLACE GANANCIA WITH VGAN
            REPLACE P_NETO WITH VP_NETO
            REPLACE IVA WITH VIVA
            REPLACE P_LISTA WITH VP_LISTA
            SELECT 2
            REPLACE COD_MERC WITH VCOD_MERC
            REPLACE S_MINIMO WITH VS_MIN
            REPLACE S_ACTUAL WITH VS_ACT
        ELSE
            LOOP
        ENDIF
    ENDIF
ENDDO
RETURN